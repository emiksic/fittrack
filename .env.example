# Copy this file to .env.local and fill in the values you have.
# The app works fully on mock/seeded data with none of these set (aside from
# DATABASE_URL, which must point at a reachable Postgres server).

# --- Database (required) ---
DATABASE_URL=postgresql://fitness:fitness_dev_pw@localhost:5432/fitness_dashboard

# --- Hevy (workouts) ---
# Requires a Hevy Pro account. Generate a key at https://hevy.com/settings?developer
HEVY_API_KEY=

# --- Strava (runs) ---
# Create an API application at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match the "Authorization Callback Domain" configured on the Strava app,
# and be reachable from the browser during the OAuth redirect.
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
